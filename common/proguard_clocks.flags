-include ../../../../../../frameworks/base/packages/SystemUI/proguard_kotlin.flags

# Ensure we're keeping relevant parts of ConstraintSet and our resources
-keepclassmembers class androidx.constraintlayout.widget.ConstraintSet { public *; }
-keepclassmembers class androidx.constraintlayout.widget.ConstraintSet$* { public *; }
-keepclassmembers class com.android.systemui.customization.clocks.R$* { public static <fields>; }
-keepclassmembers class com.android.systemui.clocks.**R$* { public static <fields>; }

# If we don't keep these compose methods than proguard becomes confused and assumes null return
# values where it should not. This can cause an NPE or other exception at runtime.
-keep !enum androidx.compose.**Scope { *; }
-keep !enum androidx.compose.runtime.** {
    *** startRestartGroup(...);
    *** getApplier(...);
}
